@* The New order form (/Orders/Create). Shown by OrdersController.Create. *@
@model Order

@{
    ViewData["Title"] = "New order";
}

<div class="page-header">
    <div>
        <h1>New order</h1>
        <p>Choose the customer and the date. You can add items after saving.</p>
    </div>
    <a asp-action="Index" class="btn btn-link"><i class="bi bi-arrow-left"></i> Back to orders</a>
</div>

<div class="card form-card">
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="CustomerId" class="form-label"></label>
                <select asp-for="CustomerId" asp-items="ViewBag.Customers" class="form-select">
                    <option value="0">-- Choose a customer --</option>
                </select>
                <span asp-validation-for="CustomerId" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="OrderDate" class="form-label"></label>
                <input asp-for="OrderDate" class="form-control" />
                <span asp-validation-for="OrderDate" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Save</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
