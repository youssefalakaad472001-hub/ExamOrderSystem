@* The "Are you sure?" page before deleting a customer (/Customers/Delete/5). Shown by CustomersController.Delete. *@
@model Customer

@{
    ViewData["Title"] = "Delete customer";

    int orderCount = ViewBag.OrderCount;
}

<div class="page-header">
    <div>
        <h1>Delete customer</h1>
        <p>Check the customer before deleting.</p>
    </div>
</div>

<div class="card form-card">
    <div class="card-body">
        <div class="person mb-4">
            <span class="avatar avatar-lg">@(string.IsNullOrEmpty(Model.Name) ? "?" : Model.Name.Substring(0, 1).ToUpper())</span>
            <div>
                <div class="h5 mb-0">@Model.Name</div>
                <div class="small-muted">@Model.Email</div>
            </div>
        </div>

        @if (orderCount > 0)
        {
            <div class="alert alert-warning">
                <i class="bi bi-exclamation-triangle me-2"></i>
                This customer has @orderCount order(s), so it cannot be deleted. Delete the orders first.
            </div>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">Back</a>
        }
        else
        {
            <p>Are you sure you want to delete this customer?</p>

            <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Yes, delete</button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">Cancel</a>
            </form>
        }
    </div>
</div>
