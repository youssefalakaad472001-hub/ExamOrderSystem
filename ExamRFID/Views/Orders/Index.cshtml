@* The order list (/Orders). Shown by OrdersController.Index. *@
@model List<OrderListItem>

@{
    ViewData["Title"] = "Orders";
}

<div class="page-header">
    <div>
        <h1>Orders</h1>
        <p>Newest orders first.</p>
    </div>
    <a asp-action="Create" class="btn btn-success"><i class="bi bi-plus-lg"></i> New order</a>
</div>

<div class="card">
    @if (Model.Count == 0)
    {
        <div class="card-body">There are no orders yet.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Order</th>
                        <th>Customer</th>
                        <th>Items</th>
                        <th class="text-end">Total</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (OrderListItem order in Model)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold">#@order.Id</div>
                                <div class="small-muted">@order.OrderDate.ToString("d")</div>
                            </td>
                            <td>
                                <div class="person">
                                    <span class="avatar">@(string.IsNullOrEmpty(order.CustomerName) ? "?" : order.CustomerName.Substring(0, 1).ToUpper())</span>
                                    <span>@order.CustomerName</span>
                                </div>
                            </td>
                            <td><span class="pill pill-purple">@order.ItemCount @(order.ItemCount == 1 ? "item" : "items")</span></td>
                            <td class="text-end fw-semibold">@order.Total.ToString("C")</td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-secondary" title="Details"><i class="bi bi-eye"></i></a>
                                <a asp-action="Edit" asp-route-id="@order.Id" class="btn btn-sm btn-outline-secondary" title="Edit"><i class="bi bi-pencil"></i></a>
                                <a asp-action="Delete" asp-route-id="@order.Id" class="btn btn-sm btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <partial name="_Pager" />
</div>
