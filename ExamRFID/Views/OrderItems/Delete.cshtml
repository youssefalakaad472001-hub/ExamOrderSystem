@* The "Are you sure?" page before deleting an item (/OrderItems/Delete/5). Shown by OrderItemsController.Delete. *@
@model OrderItem

@{
    ViewData["Title"] = "Delete item";
}

<div class="page-header">
    <div>
        <h1>Delete item from order #@Model.OrderId</h1>
        <p>Check the item before deleting.</p>
    </div>
</div>

<div class="card form-card">
    <div class="card-body">
        <dl class="info-list">
            <dt>Product</dt>
            <dd>@Model.ProductName</dd>

            <dt>Quantity</dt>
            <dd>@Model.Quantity</dd>

            <dt>Unit price</dt>
            <dd>@Model.UnitPrice.ToString("C")</dd>
        </dl>

        <p>Are you sure you want to delete this item?</p>

        <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
            <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Yes, delete</button>
            <a asp-controller="Orders" asp-action="Details" asp-route-id="@Model.OrderId" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>
