@* The customer list (/Customers). Shown by CustomersController.Index. *@
@model List<Customer>

@{
    ViewData["Title"] = "Customers";
}

<div class="page-header">
    <div>
        <h1>Customers</h1>
        <p>All the customers of the company.</p>
    </div>
    <a asp-action="Create" class="btn btn-success"><i class="bi bi-plus-lg"></i> New customer</a>
</div>

<div class="card">
    @if (Model.Count == 0)
    {
        <div class="card-body">There are no customers yet.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Customer</th>
                        <th>Email</th>
                        <th>Phone number</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (Customer customer in Model)
                    {
                        <tr>
                            <td>
                                <div class="person">
                                    <span class="avatar">@(string.IsNullOrEmpty(customer.Name) ? "?" : customer.Name.Substring(0, 1).ToUpper())</span>
                                    <span class="fw-semibold">@customer.Name</span>
                                </div>
                            </td>
                            <td>@customer.Email</td>
                            <td>@(customer.Phone ?? "-")</td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Details" asp-route-id="@customer.Id" class="btn btn-sm btn-outline-secondary" title="Details"><i class="bi bi-eye"></i></a>
                                <a asp-action="Edit" asp-route-id="@customer.Id" class="btn btn-sm btn-outline-secondary" title="Edit"><i class="bi bi-pencil"></i></a>
                                <a asp-action="Delete" asp-route-id="@customer.Id" class="btn btn-sm btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <partial name="_Pager" />
</div>
