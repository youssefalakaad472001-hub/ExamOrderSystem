@* The frame of every page: sidebar menu, success/error messages and the CSS/JS files. Used by every view (set in _ViewStart). *@
@{
    string currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sales Orders</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app">

        <aside class="sidebar">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <span class="brand-logo"><i class="bi bi-bag-check-fill"></i></span>
                Sales Orders
            </a>

            <nav class="menu">
                <div class="menu-title">Menu</div>
                <a class="menu-link @(currentController == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-grid"></i> Dashboard
                </a>
                <a class="menu-link @(currentController == "Customers" ? "active" : "")" asp-controller="Customers" asp-action="Index">
                    <i class="bi bi-people"></i> Customers
                </a>
                <a class="menu-link @(currentController == "Orders" || currentController == "OrderItems" ? "active" : "")" asp-controller="Orders" asp-action="Index">
                    <i class="bi bi-receipt"></i> Orders
                </a>
                <a class="menu-link @(currentController == "Performance" ? "active" : "")" asp-controller="Performance" asp-action="Index">
                    <i class="bi bi-speedometer2"></i> Performance
                </a>
            </nav>

            <div class="sidebar-bottom">
                <a class="menu-link px-0" asp-controller="Home" asp-action="Privacy">
                    <i class="bi bi-shield-lock"></i> Privacy
                </a>
                <div>&copy; 2026 - Sales Orders</div>
            </div>
        </aside>

        <div class="main">
            <main role="main" class="content">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success"><i class="bi bi-check-circle me-2"></i>@TempData["Success"]</div>
                }

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]</div>
                }

                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
