@* The dashboard (/). Shown by HomeController.Index. *@
@{
    ViewData["Title"] = "Dashboard";
}

<div class="page-header">
    <div>
        <h1>Dashboard</h1>
        <p>Manage customers, their orders and the items in each order.</p>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-4">
        <a asp-controller="Customers" asp-action="Index" class="tile tile-green">
            <span class="tile-icon"><i class="bi bi-people"></i></span>
            <span class="tile-label">Add, edit and look up customers and see their orders.</span>
            <span class="tile-value">Customers <i class="bi bi-arrow-right"></i></span>
        </a>
    </div>

    <div class="col-md-4">
        <a asp-controller="Orders" asp-action="Index" class="tile tile-purple">
            <span class="tile-icon"><i class="bi bi-receipt"></i></span>
            <span class="tile-label">Review orders, who placed them, when, and which items they contain.</span>
            <span class="tile-value">Orders <i class="bi bi-arrow-right"></i></span>
        </a>
    </div>

    <div class="col-md-4">
        <a asp-controller="Performance" asp-action="Index" class="tile tile-dark">
            <span class="tile-icon"><i class="bi bi-speedometer2"></i></span>
            <span class="tile-label">Compare ways of loading related data and see how many queries each one needs.</span>
            <span class="tile-value">Performance <i class="bi bi-arrow-right"></i></span>
        </a>
    </div>
</div>
