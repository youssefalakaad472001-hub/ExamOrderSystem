@* Previous / Next buttons. Used by Customers/Index and Orders/Index (reads ViewBag.Page and ViewBag.TotalPages). *@
@{
    int currentPage = ViewBag.Page;

    int totalPages = ViewBag.TotalPages;
}

@if (totalPages > 1)
{
    <nav class="d-flex justify-content-between align-items-center px-3 py-3 border-top">
        <span class="small-muted">Page @currentPage of @totalPages</span>

        <ul class="pagination pagination-sm">
            <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                <a class="page-link" asp-route-page="@(currentPage - 1)"><i class="bi bi-chevron-left"></i> Previous</a>
            </li>

            <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                <a class="page-link" asp-route-page="@(currentPage + 1)">Next <i class="bi bi-chevron-right"></i></a>
            </li>
        </ul>
    </nav>
}
