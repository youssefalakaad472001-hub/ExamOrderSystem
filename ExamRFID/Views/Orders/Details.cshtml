@* One order with its customer and items (/Orders/Details/5). Shown by OrdersController.Details. *@
@model Order

@{
    ViewData["Title"] = "Order #" + Model.Id;

    decimal orderTotal = Model.Items.Sum(i => i.Quantity * i.UnitPrice);
}

<div class="page-header">
    <div>
        <h1>Order #@Model.Id</h1>
        <p>Placed on @Model.OrderDate.ToString("D")</p>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-link"><i class="bi bi-arrow-left"></i> Back to orders</a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-secondary"><i class="bi bi-pencil"></i> Edit order</a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger"><i class="bi bi-trash"></i> Delete order</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header">Customer</div>
            <div class="card-body">
                <div class="person mb-4">
                    <span class="avatar avatar-lg">@(string.IsNullOrEmpty(Model.Customer?.Name) ? "?" : Model.Customer.Name.Substring(0, 1).ToUpper())</span>
                    <div>
                        <a class="h5 mb-0 d-block text-decoration-none" asp-controller="Customers" asp-action="Details" asp-route-id="@Model.CustomerId">@Model.Customer?.Name</a>
                        <div class="small-muted">Customer #@Model.CustomerId</div>
                    </div>
                </div>

                <dl class="info-list mb-0">
                    <dt>Customer email</dt>
                    <dd>@Model.Customer?.Email</dd>

                    <dt>Customer phone</dt>
                    <dd class="mb-0">@(Model.Customer?.Phone ?? "-")</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card h-100">
            <div class="card-header">
                <span>Items <span class="pill pill-purple ms-1">@Model.Items.Count</span></span>
                <a asp-controller="OrderItems" asp-action="Create" asp-route-orderId="@Model.Id" class="btn btn-sm btn-success"><i class="bi bi-plus-lg"></i> Add item</a>
            </div>

            @if (Model.Items.Count == 0)
            {
                <div class="card-body">This order has no items yet.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th class="text-end">Quantity</th>
                                <th class="text-end">Unit price</th>
                                <th class="text-end">Line total</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (OrderItem item in Model.Items)
                            {
                                <tr>
                                    <td>
                                        <div class="person">
                                            <span class="avatar"><i class="bi bi-box-seam"></i></span>
                                            <span>@item.ProductName</span>
                                        </div>
                                    </td>
                                    <td class="text-end">x @item.Quantity</td>
                                    <td class="text-end">@item.UnitPrice.ToString("C")</td>
                                    <td class="text-end fw-semibold">@((item.Quantity * item.UnitPrice).ToString("C"))</td>
                                    <td class="text-end text-nowrap">
                                        <a asp-controller="OrderItems" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary" title="Edit"><i class="bi bi-pencil"></i></a>
                                        <a asp-controller="OrderItems" asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <th colspan="3" class="text-end text-secondary fw-normal">Order total</th>
                                <th class="text-end fs-5">@orderTotal.ToString("C")</th>
                                <th></th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
